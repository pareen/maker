# Google OAuth (required for "Continue with Google")
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GitHub OAuth (required for "Import from GitHub" with private repos)
# Create an OAuth App at: https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# Production: URL of your GitHub token exchange proxy (e.g. Cloudflare Worker)
# In development, the Vite dev server handles this automatically.
# VITE_GITHUB_PROXY_URL=https://api.yourdomain.com/github/token

# Supabase Configuration (optional — falls back to localStorage if not set)
# Get these from your Supabase project settings: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog Analytics (optional — events are no-ops if not set)
# Get this from your PostHog project settings: https://posthog.com
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
